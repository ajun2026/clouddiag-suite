# 复制为 .env 后填写；.env 含账号密码，绝不要入库
MOFANG_BASE_URL=https://agent.cube.lenovo.com
MOFANG_APP_ID=<appId>
MOFANG_USERNAME=<服务账号>
MOFANG_PASSWORD=<密码>
MOFANG_STATE_PATH=<绝对路径>/state/session.json
MOFANG_CACHE_TTL=86400
MOFANG_KEEPALIVE_SECS=1800
MOFANG_ASK_TIMEOUT=150
PROFILE_TOKEN=<与主服务 PROFILE_*_TOKEN 一致的随机串>
PROFILE_PORT=8081
