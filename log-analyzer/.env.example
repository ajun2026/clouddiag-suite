# CloudDiag Log Analyzer — 环境变量模板
# 用法：cp .env.example .env 然后填写实际值

# ── 监听 ──
PORT=8082
HOST=127.0.0.1

# ── AI 通道（必填）──
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-chat

# ── 可选：备用 AI 通道（主通道全部失败时自动切换）──
# DEEPSEEK_BASE_URL_2=
# DEEPSEEK_API_KEY_2=
# DEEPSEEK_MODEL_2=
