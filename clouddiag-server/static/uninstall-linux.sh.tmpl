#!/bin/bash
# ============================================================
# 云端 AI 远程运维助手 — Linux 桥接器卸载脚本
#
# 用法:
#   curl -sL {{PUBLIC_URL}}/static/uninstall-linux.sh | sudo bash
#   或下载后执行: sudo bash uninstall-linux.sh
#
# 作用（只动本程序自己的文件，不碰系统其它东西）:
#   1. 停止运行中的桥接器进程
#   2. 删除程序文件（含早期误装的 /usr/local/bin/bridge）
#   3. 删除审计日志目录 ~/.clouddiag
#   4. 报告系统自带的 bridge 命令（bridge-utils）是否已恢复
# ============================================================
set -u

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; NC='\033[0m'

# 当前程序名与历史误装名
BIN_NAME="clouddiag-bridge"
TARGETS=(
    "/usr/local/bin/clouddiag-bridge"
    "/usr/bin/clouddiag-bridge"
    "$HOME/.local/bin/clouddiag-bridge"
)
LEGACY_TARGETS=(
    "/usr/local/bin/bridge"
    "/usr/bin/bridge"
)

echo "=============================================="
echo " 云端AI远程运维助手 · 桥接器卸载"
echo "=============================================="
echo ""

# ── 需要 root 才能删系统目录里的文件 ──
if [ "$(id -u)" != "0" ]; then
    if command -v sudo >/dev/null 2>&1; then
        echo "  需要 root 权限，切换到 sudo 重新执行..."
        exec sudo bash "$0" "$@"
    else
        echo -e "${RED}  错误: 请以 root 运行: sudo bash $0${NC}"
        exit 1
    fi
fi

# ── 1. 停止运行中的桥接器 ──
echo "[1/4] 停止运行中的桥接器进程..."
FOUND_PROC=0

# 精确匹配：进程的【可执行文件 basename】必须是本程序的已知名字，
# 且参数里带本程序的运行特征（-server / -room）。
# 不用 ps 的 comm 字段（内核截断到 15 字符），改为从 args 里取第一个词。
kill_matching_bridges() {
    local sig="$1"
    ps -eo pid,args --no-headers 2>/dev/null | while read -r pid args; do
        # 跳过本脚本自身
        case "$args" in *uninstall-linux*) continue ;; esac
        # 取命令第一个词，去掉路径，得到可执行文件 basename
        local exe="${args%% *}"
        exe="${exe##*/}"
        case "$exe" in
            clouddiag-bridge|clouddiag-bridge-*|bridge-linux-*|bridge-win64.exe) ;;
            *) continue ;;
        esac
        # 必须是本程序的运行形态（带 -server 或 -room 参数），避免误杀无关同名进程
        case "$args" in
            *-room*|*-server*)
                if kill $sig "$pid" 2>/dev/null; then
                    if [ "$sig" = "-9" ]; then
                        echo "  强制停止进程 $pid ($exe)"
                    else
                        echo "  已停止进程 $pid ($exe)"
                    fi
                fi
                ;;
        esac
    done
}

kill_matching_bridges "-TERM"
sleep 1
kill_matching_bridges "-9"

# 判定是否有残留（用 awk 精确取 basename，避免 grep 模式匹配到自身）
REMAIN=$(ps -eo pid,args --no-headers 2>/dev/null | awk '
{
    pid = $1
    exe = $2
    sub(/.*\//, "", exe)
    if (exe ~ /^(clouddiag-bridge|bridge-linux-)/ && $0 ~ /(-room|-server)/) print pid
}' | wc -l | tr -d ' ')
if [ "$REMAIN" != "0" ]; then
    echo -e "  ${YELLOW}警告: 仍有 $REMAIN 个桥接器进程存在，请手动检查（ps aux | grep clouddiag-bridge）${NC}"
else
    echo "  没有运行中的桥接器进程"
fi

# ── 2. 删除程序文件 ──
echo ""
echo "[2/4] 删除程序文件..."
REMOVED=0
for t in "${TARGETS[@]}"; do
    if [ -f "$t" ]; then
        rm -f "$t" && echo "  已删除 $t"
        REMOVED=1
    fi
done

# 历史误装名（早期版本装成 /usr/local/bin/bridge，会顶掉系统网桥命令）
for t in "${LEGACY_TARGETS[@]}"; do
    if [ -f "$t" ]; then
        if grep -qa "clouddiag" "$t" 2>/dev/null; then
            rm -f "$t" && echo "  已删除历史误装 $t（旧版会顶掉系统 bridge 命令）"
            REMOVED=1
        else
            echo -e "  ${YELLOW}提示: $t 已存在且不是本程序，保留未动（避免破坏系统/客户原有命令）${NC}"
        fi
    fi
done
[ "$REMOVED" = "0" ] && echo "  未找到本程序的文件（可能已卸载）"
hash -r 2>/dev/null || true

# ── 3. 删除审计日志 ──
echo ""
echo "[3/4] 删除审计日志..."
if [ -d "$HOME/.clouddiag" ]; then
    rm -rf "$HOME/.clouddiag" && echo "  已删除 $HOME/.clouddiag（含 bridge.log 审计日志）"
else
    echo "  未找到 $HOME/.clouddiag"
fi
# 其它可能位置
for d in "/root/.clouddiag" "/var/log/clouddiag"; do
    if [ -d "$d" ]; then
        rm -rf "$d" && echo "  已删除 $d"
    fi
done

# ── 4. 检查系统 bridge 命令 ──
echo ""
echo "[4/4] 检查系统 bridge 命令（bridge-utils）..."
SYSTEM_BRIDGE=""
for p in /usr/sbin/bridge /sbin/bridge /usr/bin/bridge; do
    [ -x "$p" ] && SYSTEM_BRIDGE="$p" && break
done
if [ -n "$SYSTEM_BRIDGE" ]; then
    echo -e "  ${GREEN}系统 bridge 命令可用: $SYSTEM_BRIDGE${NC}"
    command -v bridge >/dev/null 2>&1 && echo "  PATH 中的 bridge: $(command -v bridge)"
else
    echo -e "  ${YELLOW}系统未安装 bridge-utils（如需网络桥接功能可执行: sudo apt install bridge-utils）${NC}"
fi

echo ""
echo "=============================================="
echo -e " ${GREEN}桥接器已卸载${NC}"
echo "=============================================="
echo " 说明: 本脚本只删除本程序自身的文件与日志，未改动系统其它配置。"
echo ""
