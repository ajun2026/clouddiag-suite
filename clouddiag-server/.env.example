# 云端 AI 远程运维助手 — 环境变量模板
# 用法：cp .env.example .env 然后按实际环境填写
# ⚠️ 真实 .env 含密钥，切勿提交到仓库

# ══════════════════════════════════════════════
# 服务监听
# ══════════════════════════════════════════════
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# 对外可访问地址（用于生成客户机连接命令、下载链接等）
# 例：https://clouddiag.example.com  或  http://1.2.3.4:8000
# 留空则自动从请求推导
PUBLIC_URL=
# 备用访问地址（可选）——主地址不可达时自动降级
#   · 生产 HTTPS+443 且 443 可能被中间设备拦截 → 填 https://域名:8443
#   · 纯 HTTP / 内网 IP / 非标端口 / FRP 单端口 → 留空（不做降级）
PUBLIC_URL_FALLBACK=

# 允许的主机名（逗号分隔；留空表示不限制）
ALLOWED_HOSTS=

# ══════════════════════════════════════════════
# AI 大脑（二选一，由 AGENT_BRAIN 决定）
# ══════════════════════════════════════════════
# hermes = 通过 Hermes 桥调用（需配 HERMES_* 三项）
# deepseek = 直连 OpenAI 兼容 API（需配 OPENAI_* 三项）
AGENT_BRAIN=deepseek

# —— 直连通道（AGENT_BRAIN=deepseek 时必填）——
#
# ✅ 支持【任意 OpenAI 兼容接口】，常见示例：
#     DeepSeek 官方   https://api.deepseek.com/v1         模型: deepseek-chat
#     OpenAI 官方     https://api.openai.com/v1           模型: gpt-4o
#     阿里通义千问    https://dashscope.aliyuncs.com/compatible-mode/v1   模型: qwen-plus
#     智谱 GLM        https://open.bigmodel.cn/api/paas/v4               模型: glm-4-plus
#     第三方中转站    https://你的中转地址/v1              模型: 按中转站提供
#     本地部署(Ollama) http://127.0.0.1:11434/v1          模型: qwen2.5:14b 等
#
# 🔴 关键要求：模型【必须支持 Function Calling（工具调用）】。
#    本项目的诊断/修复功能依赖模型下发命令；不支持工具调用的模型无法工作。
#
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=deepseek-chat
#
# —— 可选：备用 AI 通道（主通道失败时自动切换，如额度不足/限流）——
# OPENAI_BASE_URL_2=https://api.openai.com/v1
# OPENAI_API_KEY_2=
# OPENAI_MODEL_2=gpt-4o

# —— Hermes 桥通道（AGENT_BRAIN=hermes 时必填）——
HERMES_BASE_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=
HERMES_MODEL=hermes-agent

# ══════════════════════════════════════════════
# 安全
# ══════════════════════════════════════════════
# 会话 Cookie 是否仅走 HTTPS（HTTP 环境务必设 false，否则登录态存不住）
COOKIE_SECURE=false

# 桥接器上传日志到 IDG 时校验的共享密钥（生产环境请改为随机值）
BRIDGE_HTTP_SECRET=change-me-to-a-random-string

# 管理员账号（首次启动写入数据库；后续改密码走接口）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# 会话签名密钥（留空则每次启动随机生成——多实例部署时须显式固定）
# ADMIN_SECRET=

# ══════════════════════════════════════════════
# IDG 日志分析（采集日志上传后的分析模块）
# ══════════════════════════════════════════════
# IDG 服务地址（本机部署通常为 127.0.0.1:8002 或 8082，按实际填写）
LOG_ANALYZER_UPSTREAM=http://127.0.0.1:8002

# IDG 项目目录（用于读取分析结果、写入上传文件）
LOG_ANALYZER_DIR=/opt/log-analyzer

# ══════════════════════════════════════════════
# 可选功能
# ══════════════════════════════════════════════
# 是否启用桌面类工具（截图/鼠标/键盘等，Tier 2 交互工具）：1=启用 0=关闭
ENABLE_DESKTOP_TOOLS=0
